# Production environment template for agent-service.
#
# Copy this file to `.env` on the deploy host (e.g. /srv/apps/agent-service/.env)
# and fill in real values. `.env` is host-managed and must never be committed.
#
# See docs/deployment.md for the full production deployment model.

# --- Database (required) ---
# Shared Postgres instance (e.g. on the data-services node). Do not point
# this at a local/bundled Postgres in production.
DATABASE_URL=postgres://agent:CHANGEME@<shared-postgres-host>:5432/agentdb?sslmode=require

# --- HTTP server ---
PORT=8080
LOG_LEVEL=info

# --- Model routing ---
# Comma-separated list of llm-service nodes: "name=url" or bare "url".
# Example: tiny=http://<core-node>:5101,small=http://<tags-node>:5301,medium=http://<papai>:5201
LLM_NODES=

# Optional single-node fallback, used only when LLM_NODES is unset.
LLAMA_URL=

AGENT_MAX_STEPS=10

# Optional pinned nodes (must match a name in LLM_NODES)
CHAT_NODE=
AUTOMATION_NODE=

# --- Auth ---
# Service-to-service shared secret (X-API-Key header). Leave empty to rely
# on network-level/mTLS isolation instead.
API_KEY=

# --- MCP tool runner (optional) ---
MCP_ENDPOINT=

# --- Agent catalog (optional) ---
# Path *inside the container* to a gateway-control-plane agent catalog JSON
# file. Place the actual file in ./config/ on the host so it is picked up by
# the docker-compose.prod.yml bind mount, e.g.:
#   AGENT_CATALOG_PATH=/etc/agent-service/agent-catalog.json
#   (host file: /srv/apps/agent-service/config/agent-catalog.json)
AGENT_CATALOG_PATH=

# --- Scheduler ---
SCHEDULER_ENABLED=false
SCHEDULER_POLL_INTERVAL=15s

# --- APNs push notifications (optional) ---
APNS_ENABLED=false
APNS_ENV=production
APNS_TEAM_ID=
APNS_KEY_ID=
# APNS_AUTH_KEY accepts either raw PEM contents or a path to a .p8 key file.
# In production, use a path to a host-managed file under ./config/ (picked
# up by the docker-compose.prod.yml bind mount) rather than embedding PEM
# contents in this .env file:
#   APNS_AUTH_KEY=/etc/agent-service/apns-auth-key.p8
#   (host file: /srv/apps/agent-service/config/apns-auth-key.p8)
APNS_AUTH_KEY=
APNS_TOPIC=

# --- Compose port binding (host-side) ---
# Internal-only: bind to loopback so only same-host callers (e.g.
# gateway-chat-platform) can reach this service.
AGENT_SERVICE_HOST=127.0.0.1
AGENT_SERVICE_PORT=8080
